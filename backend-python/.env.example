# MindCare AI — Backend Environment Variables (FastAPI)
# Port (automatically assigned by Render in production, default 8000 locally)
PORT=8000

# MongoDB Connection String:
# For local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/mindcare_ai
# For cloud production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mindcare_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mindcare_ai

# Google Gemini API Key:
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Frontend URL for CORS (leave empty for local dev to automatically allow localhost:3000 / localhost:5173):
FRONTEND_URL=

# Optional OpenAI fallback key (optional)
OPENAI_API_KEY=
