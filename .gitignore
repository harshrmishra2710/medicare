# =====================================================================
# MindCare AI / Medicare PBL — Git Ignore Configuration
# =====================================================================

# ── Dependencies ─────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Environment & Secrets (NEVER commit real credentials) ────────────
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# ── Python caches, bytecode, and virtual environments ────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
venv/
.venv/
ENV/
env/
*.egg-info/
.eggs/

# ── Build & Static outputs ───────────────────────────────────────────
frontend/dist/
dist/
dist-ssr/
*.local

# ── System files & IDE ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Excluded Backends (Node.js backend excluded per requirement) ─────
backend/
backend/**

# ── Deployment configurations & hosting files (Excluded per requirement) ─
DEPLOYMENT.md
DEPLOYMENT*
render.yaml
frontend/vercel.json
backend-python/runtime.txt

# ── Startup scripts & temporary batch files (Excluded per requirement) ─
*.bat
*.cmd
**/*.bat
**/*.cmd

# ── Project reports, presentations, and binary documents ─────────────
*.pdf
*.docx
*.doc
*.pptx
*.ppt
